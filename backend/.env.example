PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Workspace for uploads and pipeline outputs (created automatically if missing)
DATA_DIR=./data

# OpenMVG — path to built binaries (e.g. openMVG_main_SfMInit_ImageListing)
OPENMVG_BIN_DIR=/path/to/openMVG_Build/install/bin

# OpenMVS — path to built binaries (e.g. DensifyPointCloud, ReconstructMesh)
OPENMVS_BIN_DIR=/path/to/OpenMVS/install/bin

# Zero-DCE — repo root and checkpoint weights
ZERO_DCE_REPO_DIR=/path/to/Zero-DCE
ZERO_DCE_WEIGHTS=/path/to/Zero-DCE/snapshots/Epoch99.pth
